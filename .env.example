# ==============================================================================
# HesabYar (حساب‌یار) Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Supabase Cloud Persistence (Snapshots & Auth)
# Required for persistent multi-user data storage and authentication.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-facing Supabase configuration (optional, for frontend Vite builds)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# HesabYar REST API URL (Used internally by MCP Server when connecting to REST API)
# Defaults to http://127.0.0.1:${PORT}/api/v1 if not explicitly set.
# HESABYAR_API_URL=http://127.0.0.1:3000/api/v1

# Security & Development Flags
# NEVER enable in production. Only for local automated testing.
ALLOW_DEV_TOKENS=false
